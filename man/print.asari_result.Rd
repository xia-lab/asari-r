\name{print.asari_result}
\alias{print.asari_result}
\title{Print an asariR processing result}
\usage{
\method{print}{asari_result}(x, ...)
}
\arguments{
  \item{x}{An object returned by \code{asari_process()}.}
  \item{...}{Additional print arguments, currently ignored.}
}
